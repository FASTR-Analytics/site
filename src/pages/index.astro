---
import "../styles/tailwind.css";
import HeroBackground from "../components/HeroBackground.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>The FASTR Analytics Platform – Collaborative data analysis for health systems</title>
    <meta name="description" content="The FASTR Analytics Platform puts rigorous statistical analysis of routine health data – data quality, service utilization, coverage – in the hands of Ministry of Health teams, in minutes." />
    <meta property="og:title" content="The FASTR Analytics Platform" />
    <meta property="og:description" content="Collaborative data analysis for health systems." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://fastr-analytics.org/" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href="https://fastr-analytics.org/" />
    <link rel="alternate" hreflang="fr" href="https://fastr-analytics.org/fr/" />
  </head>
  <body>
    <!-- Nav -->
    <header class="relative z-10 bg-base-100">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 pt-6 md:pt-8 pb-4 md:pb-5 flex items-center justify-between gap-4">
        <img src="/images/FASTR_Primary_01_Horiz.png" alt="FASTR" class="h-6 md:h-7 w-auto" />
        <nav class="flex gap-5 md:gap-8 text-sm font-medium">
          <a href="/overview/" class="hover:underline underline-offset-4 whitespace-nowrap">Documentation</a>
          <a href="/fr/" class="hover:underline underline-offset-4 whitespace-nowrap text-neutral">Français</a>
        </nav>
      </div>
    </header>

    <!-- Hero -->
    <section class="relative overflow-hidden bg-primary/10 text-primary">
      <div class="relative max-w-6xl w-full mx-auto px-5 md:px-8 pt-16 md:pt-28 pb-16 md:pb-28 text-base-content">
        <h1 class="text-4xl sm:text-5xl md:text-7xl leading-[1.05] mb-5 md:mb-6 font-bold tracking-tight">
          The FASTR<br />
          <span class="text-primary">Analytics Platform.</span>
        </h1>
        <p class="text-xl md:text-3xl leading-snug mb-4 md:mb-5 font-semibold tracking-tight">
          Collaborative data analysis for health systems.
        </p>
        <p class="text-lg md:text-2xl leading-snug mb-8 text-base-content/70">
          Helping Ministries of Health monitor essential health services, assess data quality, and track coverage – through rapid-cycle analysis of the data they already collect.
        </p>
        <div class="flex flex-wrap gap-4 md:gap-6 items-center text-sm font-medium">
          <a href="/overview/" class="inline-flex items-center gap-2 bg-primary text-primary-content px-5 py-3 rounded hover:bg-primary/90 transition-colors">
            Read the documentation →
          </a>
          <a href="#what-is-fastr" class="px-2 py-2 underline underline-offset-4 decoration-2 hover:text-primary">
            Learn more
          </a>
        </div>
        <p class="mt-8 text-sm text-base-content/60">
          An initiative of the Global Financing Facility (GFF)
        </p>
      </div>
    </section>

    <!-- What is FASTR -->
    <section id="what-is-fastr" class="bg-base-100">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-16 md:py-24">
        <div class="text-xs tracking-[0.3em] uppercase mb-4 text-primary font-semibold">What it is</div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-8 md:mb-10 max-w-3xl leading-tight">
          FASTR's statistical analyses, in the hands of country teams.
        </h2>
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 text-base md:text-lg leading-relaxed max-w-5xl">
          <p>
            At the heart of the platform is the FASTR analytical methodology – rigorous statistical analysis of data quality, service utilization, and coverage, developed by the Global Financing Facility and applied with Ministries of Health in more than 20 countries. Analysis that once required specialist analysts and weeks of work.
          </p>
          <p>
            The FASTR Analytics Platform makes those analyses something a ministry team runs themselves. Import routine HMIS and facility assessment data, and the full analysis pipeline runs in minutes – producing results the team can explore, interrogate, and take straight to decision-makers.
          </p>
        </div>
      </div>
    </section>

    <!-- Video demo -->
    <section class="bg-base-200">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-16 md:py-24">
        <div class="text-xs tracking-[0.3em] uppercase mb-4 text-primary font-semibold">See it in action</div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-8 md:mb-10 max-w-3xl leading-tight">
          A quick look at the platform.
        </h2>
        <div style="padding:56.25% 0 0 0;position:relative;"><iframe src="https://player.vimeo.com/video/1179853575?badge=0&amp;autopause=0&amp;player_id=0&amp;app_id=58479" frameborder="0" allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" referrerpolicy="strict-origin-when-cross-origin" style="position:absolute;top:0;left:0;width:100%;height:100%;" title="The FASTR Analytics Platform"></iframe></div><script src="https://player.vimeo.com/api/player.js"></script>
      </div>
    </section>

    <!-- The analyses -->
    <section class="bg-base-100">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-16 md:py-24">
        <div class="text-xs tracking-[0.3em] uppercase mb-4 text-primary font-semibold">The analyses</div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-12 max-w-3xl leading-tight">
          Robust statistical analysis, run in minutes.
        </h2>
        <div class="grid md:grid-cols-3 gap-8 md:gap-12">
          <article>
            <div class="text-xs tracking-[0.3em] uppercase mb-3 text-primary font-semibold">I.</div>
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Data quality.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Automated assessment of completeness, accuracy, and consistency – with adjustments so trends reflect service delivery, not reporting artefacts.
            </p>
          </article>
          <article>
            <div class="text-xs tracking-[0.3em] uppercase mb-3 text-primary font-semibold">II.</div>
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Service utilization.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Monthly trends in priority RMNCAH-N services, including disruption analysis that compares observed volumes against expected.
            </p>
          </article>
          <article>
            <div class="text-xs tracking-[0.3em] uppercase mb-3 text-primary font-semibold">III.</div>
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Coverage.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Coverage estimates from routine data and population denominators, tracked against country-specific targets and benchmarks.
            </p>
          </article>
        </div>
        <p class="mt-10 text-base md:text-lg leading-relaxed text-base-content/70 max-w-3xl">
          Each analysis runs as a module: versioned, reproducible statistical code implementing the published FASTR methodology. Import new data and every result refreshes automatically – no programming required.
        </p>
      </div>
    </section>

    <!-- What you can make -->
    <section class="bg-base-200">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-16 md:py-24">
        <div class="text-xs tracking-[0.3em] uppercase mb-4 text-primary font-semibold">From analysis to action</div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-12 max-w-3xl leading-tight">
          Every result, ready to put in front of decision-makers.
        </h2>
        <div class="grid md:grid-cols-3 gap-8 md:gap-12">
          <article>
            <img src="/images/viz-editor-en.png" alt="The FASTR visualization editor" class="w-full rounded border border-base-300 mb-5" loading="lazy" />
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Visualizations.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Every metric the analyses produce can be explored as charts, maps, and tables – filtered, disaggregated, and exported.
            </p>
          </article>
          <article>
            <img src="/images/creating-slide-deck-en.png" alt="The FASTR slide deck editor" class="w-full rounded border border-base-300 mb-5" loading="lazy" />
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Slide decks.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Assemble analysis results into presentation-ready decks with live figures – when the data updates, the deck updates.
            </p>
          </article>
          <article>
            <img src="/images/edit-and-view-modes-en.png" alt="The FASTR report editor" class="w-full rounded border border-base-300 mb-5" loading="lazy" />
            <h3 class="text-xl md:text-2xl mb-3 font-bold">Reports.</h3>
            <p class="text-base leading-relaxed text-base-content/70">
              Long-form analytical reports with embedded live figures, ready to export and circulate.
            </p>
          </article>
        </div>
        <p class="mt-10 text-base md:text-lg leading-relaxed text-base-content/70 max-w-3xl">
          Plus live dashboards and an AI assistant that helps interpret results and draft narrative – the full path from raw data to ministerial briefing, inside one platform.
        </p>
      </div>
    </section>

    <!-- Methodology callout -->
    <section class="bg-base-100">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-16 md:py-24">
        <div class="grid md:grid-cols-5 gap-8 md:gap-16 items-start">
          <div class="md:col-span-2">
            <div class="text-xs tracking-[0.3em] uppercase mb-4 text-primary font-semibold">Methodology</div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tight leading-tight">
              Open methodology.
            </h2>
          </div>
          <div class="md:col-span-3">
            <p class="text-base md:text-lg leading-relaxed mb-6">
              The FASTR methodology documentation walks through the full process: identifying questions and indicators, extracting and preparing data, assessing data quality, estimating coverage, and communicating results. The same methods run inside the platform's modules – every result is traceable to a documented, peer-reviewable method.
            </p>
            <a href="/methodology/00_introduction/" class="inline-flex items-center gap-2 text-primary underline underline-offset-4 decoration-2 font-medium hover:no-underline">
              Read the methodology →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="relative overflow-hidden bg-primary/5 text-primary">
      <HeroBackground />
      <div class="relative max-w-6xl w-full mx-auto px-5 md:px-8 py-20 md:py-32 text-center text-base-content">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 max-w-3xl mx-auto leading-tight">
          Explore the platform in depth.
        </h2>
        <p class="text-lg md:text-xl text-base-content/70 mb-8 max-w-3xl mx-auto text-balance">
          The documentation walks through everything – setting up an instance, running the analyses, and sharing results.
        </p>
        <a href="/overview/" class="inline-flex items-center gap-2 bg-primary text-primary-content px-6 py-3 rounded text-base font-medium hover:bg-primary/90 transition-colors">
          Read the documentation →
        </a>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-base-content text-base-100">
      <div class="max-w-6xl w-full mx-auto px-5 md:px-8 py-12 md:py-16">
        <div class="grid md:grid-cols-4 gap-8 md:gap-12">
          <div class="md:col-span-2">
            <img src="/images/FASTR_White_Horiz.png" alt="FASTR" class="h-6 mb-4 w-auto" />
            <p class="text-sm leading-relaxed text-base-100/70 max-w-md">
              An initiative of the Global Financing Facility (GFF) helping countries turn routine health data into decisions in support of RMNCAH-N service delivery.
            </p>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider mb-3 text-base-100">Documentation</h4>
            <ul class="space-y-2 text-sm text-base-100/70">
              <li><a href="/overview/" class="hover:text-base-100">Overview</a></li>
              <li><a href="/admin-guide/" class="hover:text-base-100">Admin guide</a></li>
              <li><a href="/user-guide/" class="hover:text-base-100">User guide</a></li>
              <li><a href="/methodology/00_introduction/" class="hover:text-base-100">Methodology</a></li>
              <li><a href="/resources/" class="hover:text-base-100">Resources</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider mb-3 text-base-100">Site</h4>
            <ul class="space-y-2 text-sm text-base-100/70">
              <li><a href="/fr/" class="hover:text-base-100">Français</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-base-100/20 mt-10 md:mt-12 pt-6 text-xs text-base-100/50">
          FASTR · fastr-analytics.org
        </div>
      </div>
    </footer>
  </body>
</html>
